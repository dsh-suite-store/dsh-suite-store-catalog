{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dsh-suite-store/dsh-suite-store-catalog/schema/bundle.schema.json",
  "title": "Suite bundle submission",
  "description": "One file per bundle version, at suites/<owner>/<bundle_id>/<version>.yml. Path and body must agree: CI checks G1 before this schema runs. Member facts are NOT supplied here — they come from the awesome-dsh-plugin plugins.json index at build time.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "owner",
    "version",
    "title",
    "summary",
    "category",
    "members"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Bundle id. Must equal the directory name.",
      "pattern": "^[a-z0-9][a-z0-9-]{1,38}$"
    },
    "owner": {
      "type": "string",
      "description": "GitHub login. Must equal the parent directory and the PR author.",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$"
    },
    "version": {
      "type": "string",
      "description": "Semver. Must equal the file name without .yml.",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "title": {
      "$ref": "#/$defs/localized"
    },
    "summary": {
      "$ref": "#/$defs/localized",
      "description": "One sentence per language (G12)."
    },
    "description": {
      "$ref": "#/$defs/localized"
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary"
      ],
      "properties": {
        "primary": {
          "type": "string",
          "description": "A scenario category: one of the primaries in schema/categories.json.",
          "enum": [
            "getting-started",
            "productivity",
            "ui-beautify",
            "plugin-management",
            "literary-writing",
            "technical-writing",
            "design-creative",
            "multimedia",
            "development",
            "code-review",
            "architecture",
            "data-science",
            "academic-research",
            "web-search",
            "office-automation",
            "finance-ops",
            "legal",
            "education",
            "lifestyle",
            "vision",
            "voice",
            "memory",
            "context-session",
            "agent-teams",
            "model-access",
            "im-bridges",
            "remote-wsl",
            "security-audit",
            "usage-billing",
            "entertainment"
          ]
        },
        "secondary": {
          "type": "string",
          "description": "Optional chip. When present it must be one of the secondary slugs under the chosen primary (see schema/categories.json)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "primary": {
                "const": "getting-started"
              }
            },
            "required": [
              "primary"
            ]
          },
          "then": {
            "properties": {
              "secondary": {
                "enum": [
                  "daily-driver",
                  "zero-config",
                  "beginner-friendly",
                  "starter-kit"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "primary": {
                "const": "productivity"
              }
            },
            "required": [
              "primary"
            ]
          },
          "then": {
            "properties": {
              "secondary": {
                "enum": [
                  "task-board",
                  "quick-capture",
                  "side-question",
                  "notifications",
                  "spend-wallet",
                  "focus-timer",
                  "shortcuts",
                  "templates",
                  "automation",
                  "multi-task"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "primary": {
                "const": "ui-beautify"
              }
            },
            "required": [
              "primary"
            ]
          },
          "then": {
            "properties": {
              "secondary": {
                "enum": [
                  "themes",
                  "sidebar",
                  "wallpaper",
                  "status-bar",
                  "animations",
                  "glassmorphism",
                  "layout",
                  "typography",
                  "icons"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "primary": {
                "const": "plugin-management"
              }
            },
            "required": [
              "primary"
            ]
          },
          "then": {
            "properties": {
              "secondary": {
                "enum": [
                  "marketplace",
                  "discovery",
                  "installer",
                  "updater",
                  "enable-disable",
                  "dependency",
                  "backup-restore",
                  "catalog",
                  "health-check",
                  "permissions"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "primary": {
                "const": "literary-writing"
              }
            },
            "required": [
              "primary"
            ]
          },
          "then": {
