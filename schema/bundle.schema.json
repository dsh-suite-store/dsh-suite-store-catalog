    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,23}$"
      },
      "maxItems": 8,
      "uniqueItems": true
    },
    "cover": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^https://(?:github\\.com|raw\\.githubusercontent\\.com)/\\S+\\.(?:(?:[Pp][Nn][Gg])|(?:[Jj][Pp][Ee]?[Gg])|(?:[Ww][Ee][Bb][Pp]))(?:\\?\\S*)?$",
          "description": "GitHub-hosted raster image (png/jpg/jpeg/webp), either on raw.githubusercontent.com or a github.com raw/releases URL (G11). Third-party hosts and SVG are refused."
        },
        {
          "type": "null"
        }
      ]
    },
    "icon": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^https://(?:github\\.com|raw\\.githubusercontent\\.com)/\\S+\\.(?:(?:[Pp][Nn][Gg])|(?:[Jj][Pp][Ee]?[Gg])|(?:[Ww][Ee][Bb][Pp]))(?:\\?\\S*)?$",
          "description": "Optional GitHub-hosted bitmap (png/jpg/jpeg/webp) used as the market card icon; omit to fall back to the author's avatar. Third-party hosts and SVG are refused (G11)."
        },
        {
          "type": "null"
        }
      ],
      "description": "Small square image for the card and the detail sheet. Separate from `cover`, which is a wide banner: a fallback to an avatar belongs on an icon, not on a hero image."
    },
    "postInstall": {
      "$ref": "#/$defs/localized"
    },
    "capabilityRedLines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "$ref": "#/$defs/localized"
          },
          "members": {
            "type": "array",
            "description": "Member references (owner/name) this warning applies to.",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?:https://github\\.com/)?[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9][A-Za-z0-9._-]{0,99}(?:#[A-Za-z0-9._/-]+)?$"
            }
          }
        }
      }
    },
    "members": {
      "type": "array",
      "description": "2 to 10 members. Each names a plugin already in the awesome-dsh-plugin index; npm name, version, description, capabilities and stars are resolved at build time. Structural uniqueness only — `owner/name` vs its URL form is checked by scripts/validate.mjs (G4).",
      "minItems": 2,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/member"
      }
    }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en"
      ],
      "description": "Every user-authored localized string is capped at 100 characters.",
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin"
      ],
      "properties": {
        "plugin": {
          "type": "string",
          "description": "GitHub repository as owner/name (a full https://github.com/... URL is accepted). Must exist in the plugin index. This is the ONLY required member field.",
          "pattern": "^(?:https://github\\.com/)?[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9][A-Za-z0-9._-]{0,99}(?:#[A-Za-z0-9._/-]+)?$"
        },
        "reason": {
          "allOf": [
            {
              "$ref": "#/$defs/localized"
            }
          ],
          "description": "Optional. Why this member is in the suite; shown in the install sheet when present."
        },
        "requires": {
          "type": "array",
          "description": "Optional. Other members (as owner/name) this one depends on. Existence and acyclicity are checked by scripts/validate.mjs (G4), not by this schema.",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9][A-Za-z0-9._-]{0,99}(?:#[A-Za-z0-9._/-]+)?$"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
